# Rename this file to .env and fill in your values.
# .env is gitignored — never commit it with real credentials.

# Admin credentials
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_before_deploy

# JWT secret for session signing — use a long random string
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: pre-generated bcrypt hash instead of plain ADMIN_PASSWORD
# Generate: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# ADMIN_HASH=
